# Aviso de alertas por Telegram. Plantilla: el instalador la copia a provisioning/alerting/
# rellenando __BOT_TOKEN__ y __CHAT_ID__ (sólo si se elige Telegram).
apiVersion: 1

contactPoints:
  - orgId: 1
    name: TSST Telegram
    receivers:
      - uid: tsst-telegram
        type: telegram
        settings:
          bottoken: "__BOT_TOKEN__"
          chatid: "__CHAT_ID__"
          # Mensaje corto en castellano (plantilla tsst.message de abajo), en texto plano
          message: '{{ template "tsst.message" . }}'
          parse_mode: None
        disableResolveMessage: false

# Una línea por aviso: icono + qué pasa + qué hacer; al resolverse, su propio texto ("Señal recuperada"...)
templates:
  - orgID: 1
    name: tsst
    template: |
      {{ define "tsst.message" }}{{ range .Alerts.Firing }}{{ if eq .Labels.kind "manual" }}⏸️{{ else if eq .Labels.severity "critical" }}🔴{{ else if eq .Labels.severity "warning" }}🟠{{ else }}🔵{{ end }} {{ .Annotations.summary }}
      {{ .Annotations.description }}

      {{ end }}{{ range .Alerts.Resolved }}{{ if eq .Labels.kind "manual" }}▶️{{ else }}✅{{ end }} {{ if .Annotations.resolved }}{{ .Annotations.resolved }}{{ else }}Resuelto: {{ .Annotations.summary }}{{ end }}

      {{ end }}{{ end }}

policies:
  - orgId: 1
    receiver: TSST Telegram
    group_by: ['alertname']
    group_wait: 10s
    group_interval: 2m
    repeat_interval: 1h
    routes:
      # Apagado a mano desde el panel: un aviso al apagar y otro al encender, sin repetir cada hora
      - receiver: TSST Telegram
        object_matchers:
          - ['kind', '=', 'manual']
        group_by: ['alertname', 'channel', 'id']
        group_wait: 5s
        repeat_interval: 720h
